{
  "include": [
    "src",
    "scripts",
    "tests"
  ],
  "exclude": [
    "**/__pycache__",
    ".git",
    ".pytest_cache",
    ".pytest_tmp",
    ".pytest-temp",
    "logs",
    "docs",
    "docker",
    "tmp-pytest",
    "src/web"
  ],
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        "src"
      ]
    }
  ],
  "typeCheckingMode": "standard",
  "pythonVersion": "3.12",
  "reportMissingTypeStubs": false,
  "reportMissingImports": false
}
