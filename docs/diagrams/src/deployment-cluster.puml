@startuml
left to right direction
scale 0.8
skinparam dpi 120
skinparam defaultFontSize 11

actor "Dashboard / External Client" as client

rectangle "Node A" as nodeA {
  component "Runtime" as rtA
  component "TCP" as tcpA
  component "Web API" as apiA
}

rectangle "Node B" as nodeB {
  component "Runtime" as rtB
  component "TCP" as tcpB
  component "Web API" as apiB
}

rectangle "Node N" as nodeN {
  component "Runtime" as rtN
  component "TCP" as tcpN
  component "Web API" as apiN
}

rtA --> tcpA : manages
rtA --> apiA : manages
rtB --> tcpB : manages
rtB --> apiB : manages
rtN --> tcpN : manages
rtN --> apiN : manages

tcpA <--> tcpB
tcpB <--> tcpN
tcpA <--> tcpN

client --> apiA : HTTP
client --> apiB : HTTP

note bottom
Peer-to-peer traffic is best-effort over TCP.
Observer traffic is read-only and does not mutate distributed state.
end note

@enduml
