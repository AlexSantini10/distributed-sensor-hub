@startuml
title Distributed Sensor Hub - Module Dependencies

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #4B5563
skinparam PackageBorderColor #1F2937
skinparam PackageFontColor #111827
skinparam ComponentBorderColor #1F2937
skinparam ComponentFontColor #111827

legend right
  This diagram shows top-level code dependencies between core modules.
  An arrow A --> B means "A depends on B".
  Shared support modules such as utils are intentionally omitted.
endlegend

component "node.py" as node

package "runtime" as runtime
package "protocol" as protocol
package "networking" as networking
package "membership" as membership
package "fd" as fd
package "gossip" as gossip
package "state" as state
package "sensors" as sensors
package "webapi" as webapi
package "topology" as topology
component "web/\n(static UI)" as web

node --> runtime

runtime --> networking
runtime --> protocol
runtime --> membership
runtime --> gossip
runtime --> sensors
runtime --> state
runtime --> webapi
runtime --> topology

protocol --> membership

networking --> protocol

membership --> fd

gossip --> membership
gossip --> protocol
gossip --> topology

sensors --> state

webapi --> protocol

web ..> webapi : HTTP polling

@enduml
